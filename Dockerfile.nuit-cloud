# The MinIO server as the Nuit Cloud platform runs it (see NUIT-CLOUD.md). Compiled from this repository's own source, unchanged from upstream
# at the release this branch starts from, and stamped the way upstream's release build stamps it (buildscripts/gen-ldflags.go). `mc` comes
# from the fork's own published image, pinned by digest: the platform's health check runs `mc ready local`.
#
#   docker buildx build -f Dockerfile.nuit-cloud --platform linux/amd64,linux/arm64 .
#
# Go cross-compiles on the builder's own platform for the target's (CGO off, so the binary is static), and the final stage runs nothing:
# no step runs under emulation.
ARG GO_IMAGE=golang:1.24-alpine
# ghcr.io/nuit-cloud/mc, released from github.com/nuit-cloud/mc; move to a new release by changing the digest
ARG MC_IMAGE=ghcr.io/nuit-cloud/mc@sha256:acf26f84e40e3714f32e4096d9be520fe0cb20eb02fedef5de1f7efd668e9481

FROM ${MC_IMAGE} AS mc

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG TARGETOS=linux
ARG TARGETARCH
# The release this source is (upstream's tag) and its commit: what `minio --version` reports. The image's revision label names the commit built.
ARG RELEASE=RELEASE.2025-10-15T17-29-55Z
ARG COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    set -eu; t="${RELEASE#RELEASE.}"; t="${t%%Z*}"; d="${t%%T*}"; h="$(echo "${t#*T}" | tr - :)"; \
    year="$(echo "$d" | cut -c1-4)"; p=github.com/minio/minio/cmd; \
    CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="${TARGETARCH:-$(go env GOARCH)}" go build -trimpath -tags kqueue -o /out/minio \
      -ldflags "-s -w -X $p.Version=${d}T${h}Z -X $p.CopyrightYear=$year -X $p.ReleaseTag=$RELEASE -X $p.CommitID=$COMMIT -X $p.ShortCommitID=$(echo "$COMMIT" | cut -c1-12)" .

FROM alpine:3.22
ARG RELEASE=RELEASE.2025-10-15T17-29-55Z
ARG REVISION=unknown
LABEL org.opencontainers.image.title="minio" \
      org.opencontainers.image.description="The MinIO server, built from the Nuit Cloud fork of github.com/minio/minio, with mc for its health check" \
      org.opencontainers.image.source="https://github.com/nuit-cloud/minio" \
      org.opencontainers.image.version="$RELEASE" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
# the certificates are the same files on every platform, so nothing here runs in the target's architecture
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/minio /usr/bin/minio
COPY --from=mc /mc /usr/bin/mc
# the settings MinIO's own image set: credentials may come from files (Docker secrets), and mc keeps its config somewhere writable
ENV MINIO_ACCESS_KEY_FILE=access_key MINIO_SECRET_KEY_FILE=secret_key MINIO_ROOT_USER_FILE=access_key MINIO_ROOT_PASSWORD_FILE=secret_key \
    MINIO_KMS_SECRET_KEY_FILE=kms_master_key MINIO_CONFIG_ENV_FILE=config.env MC_CONFIG_DIR=/tmp/.mc
EXPOSE 9000
VOLUME ["/data"]
ENTRYPOINT ["minio"]
CMD ["server", "/data"]
